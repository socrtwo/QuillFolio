<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with QuillFolio" for presentations identified by MIME type
                 (a mimeType-only <data> matches content: and file: URIs). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.ms-powerpoint.presentation.macroEnabled.12" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.slideshow" />
                <data android:mimeType="application/vnd.ms-powerpoint.slideshow.macroEnabled.12" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.template" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation-template" />
                <data android:mimeType="application/vnd.oasis.opendocument.flat-presentation" />
                <data android:mimeType="application/vnd.sun.xml.impress" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-quillfolio" />
                <data android:mimeType="application/x-quillfolio-encrypted" />
            </intent-filter>

            <!-- Files whose provider reports a generic MIME type: match on extension.
                 Several pathPatterns per extension because Android's matcher is
                 non-greedy and stops at the first dot. Upper-case variants cover
                 names such as DECK.PPTX from Windows shares. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:pathPattern=".*\\.pptx" />
                <data android:pathPattern=".*\\..*\\.pptx" />
                <data android:pathPattern=".*\\..*\\..*\\.pptx" />
                <data android:pathPattern=".*\\.PPTX" />
                <data android:pathPattern=".*\\..*\\.PPTX" />
                <data android:pathPattern=".*\\..*\\..*\\.PPTX" />
                <data android:pathPattern=".*\\.pptm" />
                <data android:pathPattern=".*\\..*\\.pptm" />
                <data android:pathPattern=".*\\..*\\..*\\.pptm" />
                <data android:pathPattern=".*\\.PPTM" />
                <data android:pathPattern=".*\\..*\\.PPTM" />
                <data android:pathPattern=".*\\..*\\..*\\.PPTM" />
                <data android:pathPattern=".*\\.ppsx" />
                <data android:pathPattern=".*\\..*\\.ppsx" />
                <data android:pathPattern=".*\\..*\\..*\\.ppsx" />
                <data android:pathPattern=".*\\.PPSX" />
                <data android:pathPattern=".*\\..*\\.PPSX" />
                <data android:pathPattern=".*\\..*\\..*\\.PPSX" />
                <data android:pathPattern=".*\\.ppsm" />
                <data android:pathPattern=".*\\..*\\.ppsm" />
                <data android:pathPattern=".*\\..*\\..*\\.ppsm" />
                <data android:pathPattern=".*\\.PPSM" />
                <data android:pathPattern=".*\\..*\\.PPSM" />
                <data android:pathPattern=".*\\..*\\..*\\.PPSM" />
                <data android:pathPattern=".*\\.potx" />
                <data android:pathPattern=".*\\..*\\.potx" />
                <data android:pathPattern=".*\\..*\\..*\\.potx" />
                <data android:pathPattern=".*\\.POTX" />
                <data android:pathPattern=".*\\..*\\.POTX" />
                <data android:pathPattern=".*\\..*\\..*\\.POTX" />
                <data android:pathPattern=".*\\.potm" />
                <data android:pathPattern=".*\\..*\\.potm" />
                <data android:pathPattern=".*\\..*\\..*\\.potm" />
                <data android:pathPattern=".*\\.POTM" />
                <data android:pathPattern=".*\\..*\\.POTM" />
                <data android:pathPattern=".*\\..*\\..*\\.POTM" />
                <data android:pathPattern=".*\\.ppt" />
                <data android:pathPattern=".*\\..*\\.ppt" />
                <data android:pathPattern=".*\\..*\\..*\\.ppt" />
                <data android:pathPattern=".*\\.PPT" />
                <data android:pathPattern=".*\\..*\\.PPT" />
                <data android:pathPattern=".*\\..*\\..*\\.PPT" />
                <data android:pathPattern=".*\\.pps" />
                <data android:pathPattern=".*\\..*\\.pps" />
                <data android:pathPattern=".*\\..*\\..*\\.pps" />
                <data android:pathPattern=".*\\.PPS" />
                <data android:pathPattern=".*\\..*\\.PPS" />
                <data android:pathPattern=".*\\..*\\..*\\.PPS" />
                <data android:pathPattern=".*\\.pot" />
                <data android:pathPattern=".*\\..*\\.pot" />
                <data android:pathPattern=".*\\..*\\..*\\.pot" />
                <data android:pathPattern=".*\\.POT" />
                <data android:pathPattern=".*\\..*\\.POT" />
                <data android:pathPattern=".*\\..*\\..*\\.POT" />
                <data android:pathPattern=".*\\.odp" />
                <data android:pathPattern=".*\\..*\\.odp" />
                <data android:pathPattern=".*\\..*\\..*\\.odp" />
                <data android:pathPattern=".*\\.ODP" />
                <data android:pathPattern=".*\\..*\\.ODP" />
                <data android:pathPattern=".*\\..*\\..*\\.ODP" />
                <data android:pathPattern=".*\\.otp" />
                <data android:pathPattern=".*\\..*\\.otp" />
                <data android:pathPattern=".*\\..*\\..*\\.otp" />
                <data android:pathPattern=".*\\.OTP" />
                <data android:pathPattern=".*\\..*\\.OTP" />
                <data android:pathPattern=".*\\..*\\..*\\.OTP" />
                <data android:pathPattern=".*\\.fodp" />
                <data android:pathPattern=".*\\..*\\.fodp" />
                <data android:pathPattern=".*\\..*\\..*\\.fodp" />
                <data android:pathPattern=".*\\.FODP" />
                <data android:pathPattern=".*\\..*\\.FODP" />
                <data android:pathPattern=".*\\..*\\..*\\.FODP" />
                <data android:pathPattern=".*\\.sxi" />
                <data android:pathPattern=".*\\..*\\.sxi" />
                <data android:pathPattern=".*\\..*\\..*\\.sxi" />
                <data android:pathPattern=".*\\.SXI" />
                <data android:pathPattern=".*\\..*\\.SXI" />
                <data android:pathPattern=".*\\..*\\..*\\.SXI" />
                <data android:pathPattern=".*\\.md" />
                <data android:pathPattern=".*\\..*\\.md" />
                <data android:pathPattern=".*\\..*\\..*\\.md" />
                <data android:pathPattern=".*\\.MD" />
                <data android:pathPattern=".*\\..*\\.MD" />
                <data android:pathPattern=".*\\..*\\..*\\.MD" />
                <data android:pathPattern=".*\\.qsp" />
                <data android:pathPattern=".*\\..*\\.qsp" />
                <data android:pathPattern=".*\\..*\\..*\\.qsp" />
                <data android:pathPattern=".*\\.QSP" />
                <data android:pathPattern=".*\\..*\\.QSP" />
                <data android:pathPattern=".*\\..*\\..*\\.QSP" />
                <data android:pathPattern=".*\\.qspe" />
                <data android:pathPattern=".*\\..*\\.qspe" />
                <data android:pathPattern=".*\\..*\\..*\\.qspe" />
                <data android:pathPattern=".*\\.QSPE" />
                <data android:pathPattern=".*\\..*\\.QSPE" />
                <data android:pathPattern=".*\\..*\\..*\\.QSPE" />
            </intent-filter>

            <!-- Receive presentations and text shared from other apps. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.ms-powerpoint.presentation.macroEnabled.12" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.slideshow" />
                <data android:mimeType="application/vnd.ms-powerpoint.slideshow.macroEnabled.12" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.template" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation-template" />
                <data android:mimeType="application/vnd.oasis.opendocument.flat-presentation" />
                <data android:mimeType="application/vnd.sun.xml.impress" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-quillfolio" />
                <data android:mimeType="application/x-quillfolio-encrypted" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- The Quill apps this one can hand documents to (Android 11+ package visibility). -->
    <queries>
        <package android:name="io.github.socrtwo.quillpen" />
        <package android:name="io.github.socrtwo.quillpost" />
        <package android:name="io.github.socrtwo.quillgrid" />
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
